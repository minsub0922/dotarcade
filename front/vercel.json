{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://dotarcade-back-production.up.railway.app/api/:path*" },
    { "source": "/play/:path*", "destination": "https://dotarcade-back-production.up.railway.app/play/:path*" },
    { "source": "/:path((?!api|play).*)", "destination": "/index.html" }
  ]
}
