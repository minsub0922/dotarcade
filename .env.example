# DOTCADE 통합 환경변수 — 레포 루트의 .env 하나로 front·back 모두 설정합니다.
# 사용법: cp .env.example .env 후 값 채우기
# 규칙: BACK_* 은 back(Express)만, FRONT_* 은 front(serve.js·vite)만 읽습니다. 접두사 없는 키는 없습니다.

# ───────── BACK (Express — back/server) ─────────
BACK_PORT=5175                              # API 서버 포트
BACK_GEMINI_API_KEY=                        # https://aistudio.google.com/apikey — 없으면 자동 mock 모드
BACK_GEMINI_MODEL_SMART=gemini-3.6-flash    # 구현·아키텍처 등 고품질 단계
BACK_GEMINI_MODEL_FAST=gemini-3.5-flash-lite # 발화·피드백 등 경량 단계
BACK_GEMINI_MODEL_EMBED=gemini-embedding-2  # RAG 임베딩
BACK_MAX_LLM_CONCURRENCY=4                  # LLM 동시 호출 세마포어 (무료 키는 3~4 권장)
BACK_LLM_MODE=auto                          # auto | live | mock
BACK_TAVILY_API_KEYS=                       # 쉼표 구분 여러 개 — 로테이션 사용 (예: tvly-aaa,tvly-bbb)

# ───────── FRONT (serve.js · vite dev — front/) ─────────
FRONT_PORT=5173                             # 프론트 서버 포트 (dev·배포 공통)
FRONT_BACK_ORIGIN=http://localhost:5175     # /api·/play 프록시 대상 (백엔드 주소)
